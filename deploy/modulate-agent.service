[Unit]
Description=Modulate on-device AI agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/modulate-product
ExecStart=/home/pi/modulate-product/.venv/bin/python -m modulate.studio --standalone --state-dir /home/pi/modulate-product/brain --connect-env-file /home/pi/modulate-product/brain/provider.env --budget 50
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
