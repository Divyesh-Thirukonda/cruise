[Unit]
Description=Modulate physical controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/modulate-product
ExecStart=/home/pi/modulate-product/.venv/bin/python -m modulate.device --state-dir /home/pi/modulate-product/state --enrollment /home/pi/modulate-product/device-enrollment.json
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3
TimeoutStopSec=12

[Install]
WantedBy=multi-user.target
