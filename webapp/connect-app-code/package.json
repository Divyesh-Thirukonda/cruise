{
  "name": "modulate-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Modulate Connect: the standalone connection dashboard and server gateway",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "0.511.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --runInBand",
    "test:api": "node --test tests/modulate-api.test.cjs",
    "verify:source": "node scripts/verify-source.cjs",
    "check": "npm run verify:source && npm run test:api && npm test && npm run build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
