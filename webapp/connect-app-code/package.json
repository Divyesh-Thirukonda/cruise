{
  "name": "modulate-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Modulate Connect: the standalone connection dashboard and server gateway",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "0.511.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "next": "16.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2"
  },
  "scripts": {
    "start": "next start",
    "build": "next build",
    "test": "jest --runInBand",
    "test:api": "node --test tests/*.test.cjs",
    "verify:source": "node scripts/verify-source.cjs",
    "check": "npm run verify:source && npm run test:api && npm test && npm run build",
    "dev": "next dev"
  }
}
