# Development dashboard tunnel only. AI requests call Vercel directly and do
# not depend on this tunnel. Quick Tunnel URLs change on process restart; update
# MODULATE_COMPANION_URL before claiming the website has reconnected.
[Unit]
Description=Modulate optional browser dashboard tunnel
After=network-online.target modulate-agent.service
Wants=network-online.target modulate-agent.service

[Service]
Type=simple
User=pi
ExecStart=/home/pi/.local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8789
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
